DATABASE_URL=postgres://console:console@localhost:5432/console?sslmode=disable
PORT=3000
SESSION_SECRET=change-me-to-at-least-32-characters-long
S3_BUCKET=console-dev
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=console
AWS_SECRET_ACCESS_KEY=consoleconsole
NODE_ENV=development

WORKER_BASE_URL=https://your-worker.workers.dev
WORKER_TRIGGER_SECRET=the-workers-TRIGGER_SECRET
WORKER_HMAC_SECRET=must-match-the-workers-CONSOLE_HMAC_SECRET
# Where the Worker reaches this console. Locally nothing can, so DIALER=fake.
PUBLIC_BASE_URL=https://console.example.com
DIALER=fake

# Must be the same key the Worker holds; the console uses it only to delete
# recordings once they are safely in S3.
TELNYX_API_KEY=match-the-worker-TELNYX_API_KEY
ELEVENLABS_API_KEY=sk_...
