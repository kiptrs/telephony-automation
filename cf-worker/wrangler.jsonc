{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rtc-telnyx",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public"
  },
  "durable_objects": {
    "bindings": [{ "name": "CALL_SESSIONS", "class_name": "CallSession" }]
  },
  // new_sqlite_classes (not new_classes): SQLite-backed Durable Objects are
  // the variant available on the Workers free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CallSession"] }],
  "observability": {
    "enabled": true
  }
}
